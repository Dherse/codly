%YAML 1.2
---
name: Codly Rainbow Test
file_extensions: [codly-rainbow-test]
scope: source.codly-rainbow-test
contexts:
  main:
    - match: '\bword\b'
      scope: keyword.control.custom
    - match: '~.*'
      scope: custom.ignored
    - match: '%'
      push:
        - meta_scope: string.quoted.custom
        - match: '%'
          pop: true
